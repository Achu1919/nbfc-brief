{
  "name": "NBFC Brief",
  "short_name": "NBFC Brief",
  "description": "A daily, sourced summary of public NBFC news, RBI/SEBI/IBBI circulars, market numbers and a regulatory calendar. Independent; not an official view of Muthoot Fincorp Ltd.",
  "id": "/?app=nbfc-brief",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#F3F1EC",
  "theme_color": "#F3F1EC",
  "lang": "en-IN",
  "categories": ["finance", "news", "business"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "News desk", "url": "/#/latest/01-daily-watch", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Rules desk", "url": "/#/latest/02-regulation", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Archive", "url": "/#/archive", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
